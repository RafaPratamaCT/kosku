# ==========================================================
# KosKu — contoh konfigurasi environment
# Salin file ini jadi ".env" lalu isi nilainya.
#   cp .env.example .env
# ==========================================================

# Koneksi PostgreSQL.
# Lokal (Postgres di komputer sendiri):
DATABASE_URL="postgresql://postgres:password@localhost:5432/kosku?schema=public"

# Contoh kalau pakai Neon / Supabase / Vercel Postgres:
# DATABASE_URL="postgresql://user:password@host.neon.tech/kosku?sslmode=require"

# Kunci rahasia untuk menandatangani cookie session.
# WAJIB diganti dengan string acak minimal 32 karakter.
# Cara bikin cepat:  openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ya"

# Token rahasia untuk memanggil endpoint cron
# (/api/cron/expire-bookings dan /api/cron/generate-bills).
CRON_SECRET="ganti-juga-dengan-string-acak"

# Alamat publik aplikasi. Dipakai untuk link di PDF & notifikasi.
# Lokal: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsional — memaksa lokasi penyimpanan berkas unggahan.
# Dikosongkan = otomatis (lokal di komputer, database saat di Vercel).
#   local    -> selalu ke /public/uploads
#   database -> selalu ke tabel FileBlob, disajikan lewat /api/files/[id]
# FILE_STORAGE="database"
